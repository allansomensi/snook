<?xml version='1.0' encoding='windows-1252'?>
<!--
  The Windows installer (.msi) of Snookered, built by dist with cargo-wix
  (WiX Toolset 3). Based on cargo-wix's template, Copyright (C) 2017
  Christopher R. Field, Apache License 2.0.

  Edited by hand (dist-workspace.toml has allow-dirty = ["msi"], so
  `dist generate` leaves it alone):
  - the game installs in Program Files\Snookered, with a Start menu shortcut and
    an optional desktop shortcut, and no PATH entry (it isn't a command);
  - the emblem is the icon of the shortcuts and of "Installed apps";
  - the dialogs carry the emblem (assets\icon\wix-*.bmp, made by the
    `export_icons` test in src\icon.rs).

  Variables set by cargo-wix: Version, CargoTargetBinDir (the folder with
  snookered.exe), CargoProfile, TargetTriple...
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<?define Assets = "$(sys.SOURCEFILEDIR)..\assets\icon" ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Snookered'
        UpgradeCode='38A3FD0E-86A2-4518-A4AF-067047C4D793'
        Manufacturer='Allan Somensi'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Snookered: 3D eight-ball pool'
            Manufacturer='Allan Somensi'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <!-- Windows Installer compares only the first three parts of a
             version, and the betas differ only in the fourth (0.1.1-beta.2
             is 0.1.1.2): without AllowSameVersionUpgrades a new beta would
             be installed next to the old one and keep its snookered.exe. The old
             version is removed before the new one is installed. -->
        <MajorUpgrade
            AllowSameVersionUpgrades='yes'
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Snookered Installation'/>

        <Icon Id='SnookeredIcon' SourceFile='$(var.Assets)\snookered.ico'/>
        <Property Id='ARPPRODUCTICON' Value='SnookeredIcon'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/allansomensi/snookered'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/allansomensi/snookered'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Snookered'>
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='snookered.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\snookered.exe'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
            <!-- Each shortcut is a component of its own in the folder it goes
                 to, keyed by a value under HKCU (what the installer's
                 validation, ICE38/ICE43, asks of shortcuts in those folders).
                 They point at the game by its path, not [#exe0]: a file of
                 another component is refused by ICE69. -->
            <Directory Id='ProgramMenuFolder'>
                <Component Id='StartMenuShortcut' Guid='67F2BA8F-B4E2-426A-940B-1EDA367ED15C'>
                    <Shortcut
                        Id='StartMenuShortcut'
                        Name='Snookered'
                        Description='3D eight-ball pool'
                        Target='[APPLICATIONFOLDER]snookered.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='SnookeredIcon'/>
                    <RegistryValue
                        Root='HKCU'
                        Key='Software\Snookered\Installer'
                        Name='StartMenuShortcut'
                        Type='integer'
                        Value='1'
                        KeyPath='yes'/>
                </Component>
            </Directory>
            <Directory Id='DesktopFolder' Name='Desktop'>
                <Component Id='DesktopShortcut' Guid='7C1D16AB-8E35-49A9-AB71-4A2B2AB8EC2D'>
                    <Shortcut
                        Id='DesktopShortcut'
                        Name='Snookered'
                        Description='3D eight-ball pool'
                        Target='[APPLICATIONFOLDER]snookered.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='SnookeredIcon'/>
                    <RegistryValue
                        Root='HKCU'
                        Key='Software\Snookered\Installer'
                        Name='DesktopShortcut'
                        Type='integer'
                        Value='1'
                        KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Snookered'
            Description='The game, with a shortcut in the Start menu.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='StartMenuShortcut'/>

            <Feature
                Id='Desktop'
                Title='Desktop shortcut'
                Description='A shortcut to Snookered on the desktop.'
                Level='1'
                AllowAdvertise='no'
                Absent='allow'>
                <ComponentRef Id='DesktopShortcut'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <!-- No license page: straight from the welcome to the choices. -->
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

        <!-- The emblem on the installer's pages (493x58 banner, 493x312 welcome). -->
        <WixVariable Id='WixUIBannerBmp' Value='$(var.Assets)\wix-banner.bmp'/>
        <WixVariable Id='WixUIDialogBmp' Value='$(var.Assets)\wix-dialog.bmp'/>

    </Product>

</Wix>
